{
  "description": "Every public repository of latere-ai and its kind, as standard/README.md defines them. `uses` names a GitHub feature the repository uses that is off by default. `packages` names the container images it publishes, since GitHub's list of the organization's packages can leave one out. `exempt` says why the standard does not apply.",
  "repositories": {
    ".github": {"kind": "organization"},
    "agent-skills": {"kind": "tool"},
    "agon": {"kind": "library"},
    "ai-as-an-infrastructure": {"kind": "content"},
    "apps": {"kind": "library"},
    "arca": {"kind": "service", "packages": ["arcad", "arca-stubs"]},
    "cella": {"kind": "service"},
    "ci": {"kind": "tool"},
    "ci-gate": {"kind": "tool"},
    "examen": {"kind": "service"},
    "forma": {"kind": "library"},
    "fornax": {"kind": "tool"},
    "latere-cli": {"kind": "tool"},
    "latere-ui": {"kind": "library"},
    "lectio": {"kind": "service"},
    "limen": {"kind": "service"},
    "lux": {"kind": "service", "packages": ["lux", "lux-stubs"]},
    "managed-agents": {"kind": "library"},
    "mc": {"exempt": "a maintained fork keeps its upstream's files and layout"},
    "minio": {"exempt": "a maintained fork keeps its upstream's files and layout"},
    "origo": {"kind": "service", "packages": ["origod", "origo-stubs"]},
    "origo-web": {"kind": "service"},
    "pay": {"kind": "library"},
    "pkg": {"kind": "library"},
    "pons": {"kind": "service"},
    "replichai": {"kind": "service"},
    "sandbox-images": {"kind": "tool"},
    "sdk-go": {"kind": "library"},
    "sermo": {"kind": "service", "packages": ["sermod"]},
    "service-template": {"kind": "tool"},
    "status": {"kind": "service"},
    "topos": {"kind": "service"}
  }
}
